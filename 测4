  <script>
    (function() {
      const pageLoader = document.getElementById('pageLoader');
      const loaderPercent = document.getElementById('loaderPercent');
      const authLayer = document.getElementById('authLayer');
      const mainInterface = document.getElementById('mainInterface');
      const passwordInput = document.getElementById('passwordInput');
      const authBtn = document.getElementById('authBtn');
      const authError = document.getElementById('authError');
      const VALID_PASS = '0000';

      let loaderInterval = null;

      // 雷达图绘制
      function drawRadarChart(config) {
        const { svgPrefix, data } = config;
        const gridGroup = document.getElementById(`radarGrid${svgPrefix}`);
        const axesGroup = document.getElementById(`radarAxes${svgPrefix}`);
        const labelsGroup = document.getElementById(`radarLabels${svgPrefix}`);
        const polyEl = document.getElementById(`radarPoly${svgPrefix}`);
        if (!gridGroup || !axesGroup || !labelsGroup || !polyEl) return;

        gridGroup.innerHTML = '';
        axesGroup.innerHTML = '';
        labelsGroup.innerHTML = '';

        const centerX = 110, centerY = 110, maxRadius = 75;
        const numAxes = data.length;
        const angleStep = (Math.PI * 2) / numAxes;

        const layers = 5;
        for (let l = 1; l <= layers; l++) {
          const r = (maxRadius / layers) * l;
          const points = [];
          for (let i = 0; i < numAxes; i++) {
            const angle = -Math.PI / 2 + i * angleStep;
            const x = centerX + r * Math.cos(angle);
            const y = centerY + r * Math.sin(angle);
            points.push(`${x},${y}`);
          }
          const polygon = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
          polygon.setAttribute('points', points.join(' '));
          polygon.setAttribute('class', 'radar-grid-line');
          gridGroup.appendChild(polygon);
        }

        for (let i = 0; i < numAxes; i++) {
          const angle = -Math.PI / 2 + i * angleStep;
          const x = centerX + maxRadius * Math.cos(angle);
          const y = centerY + maxRadius * Math.sin(angle);
          const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          line.setAttribute('x1', centerX);
          line.setAttribute('y1', centerY);
          line.setAttribute('x2', x);
          line.setAttribute('y2', y);
          line.setAttribute('class', 'radar-axis');
          axesGroup.appendChild(line);
        }

        const points = [];
        for (let i = 0; i < numAxes; i++) {
          const value = data[i].value;
          const max = data[i].max || 100;
          const ratio = Math.min(value / max, 1);
          const r = maxRadius * ratio;
          const angle = -Math.PI / 2 + i * angleStep;
          const x = centerX + r * Math.cos(angle);
          const y = centerY + r * Math.sin(angle);
          points.push(`${x},${y}`);
        }
        polyEl.setAttribute('points', points.join(' '));
        polyEl.setAttribute('fill', 'rgba(178, 34, 34, 0.15)');
        polyEl.setAttribute('stroke', '#b22222');

        for (let i = 0; i < numAxes; i++) {
          const angle = -Math.PI / 2 + i * angleStep;
          const labelR = maxRadius + 18;
          const x = centerX + labelR * Math.cos(angle);
          const y = centerY + labelR * Math.sin(angle);
          const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
          text.setAttribute('x', x);
          text.setAttribute('y', y);
          text.setAttribute('class', 'radar-label');
          text.setAttribute('fill', '#888');
          text.setAttribute('font-size', '8');
          text.setAttribute('text-anchor', 'middle');
          text.setAttribute('dominant-baseline', 'middle');
          const shortLabel = data[i].label.split(' ')[0] || data[i].label;
          text.textContent = shortLabel;
          labelsGroup.appendChild(text);
        }
      }

      function initRadarCharts() {
        const zongData = [
          { label: '力量', value: 97, max: 100 },
          { label: '速度', value: 99, max: 100 },
          { label: '爆发力', value: 94, max: 100 },
          { label: '技巧', value: 100, max: 100 },
          { label: '语言', value: 23, max: 100 },
          { label: '直觉', value: 93, max: 100 },
          { label: '执行', value: 76, max: 100 },
        ];
        const jiangData = [
          { label: '记忆', value: 100, max: 100 },
          { label: '反应', value: 98, max: 100 },
          { label: '分析', value: 95, max: 100 },
          { label: '观察', value: 92, max: 100 },
          { label: '谋略', value: 99, max: 100 },
          { label: '应变', value: 89, max: 100 },
          { label: '耐力', value: 23, max: 100 },
        ];
        drawRadarChart({ svgPrefix: 'Zong', data: zongData });
        drawRadarChart({ svgPrefix: 'Jiang', data: jiangData });
      }

      // 标签切换
      function initTabs() {
        const tabBtns = document.querySelectorAll('.tab-btn');
        const panels = {
          tab1: document.getElementById('tab1'),
          tab2: document.getElementById('tab2'),
          tab3: document.getElementById('tab3'),
          tab4: document.getElementById('tab4'),
          tab5: document.getElementById('tab5')
        };

        tabBtns.forEach(btn => {
          btn.addEventListener('click', function() {
            const tabId = this.dataset.tab;
            tabBtns.forEach(b => b.classList.remove('active'));
            Object.values(panels).forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            if (panels[tabId]) panels[tabId].classList.add('active');
            if (tabId === 'tab1') {
              const polys = document.querySelectorAll('.radar-poly');
              polys.forEach(p => {
                p.style.animation = 'none';
                p.offsetHeight;
                p.style.animation = 'radarExpand 0.9s ease-out forwards';
              });
            }
          });
        });
      }

      // IP 动画
      function startIpAnimation() {
        const ipEl = document.getElementById('ipAddress');
        if (!ipEl) return;
        const baseIp = '10.27.62.';
        setInterval(() => {
          const lastOctet = Math.floor(Math.random() * 254) + 1;
          ipEl.textContent = baseIp + lastOctet;
        }, 1800);
      }

      // 加载动画
      function startLoader(callback) {
        pageLoader.classList.add('active');
        pageLoader.classList.remove('hidden');
        let progress = 0;
        loaderPercent.textContent = 'LOADING 0%';
        if (loaderInterval) clearInterval(loaderInterval);
        loaderInterval = setInterval(() => {
          progress += Math.floor(Math.random() * 12) + 3;
          if (progress >= 100) {
            progress = 100;
            clearInterval(loaderInterval);
            loaderInterval = null;
            loaderPercent.textContent = 'LOADING 100%';
            setTimeout(() => {
              pageLoader.classList.add('hidden');
              setTimeout(() => {
                pageLoader.classList.remove('active');
              }, 600);
              if (callback) callback();
            }, 300);
          } else {
            loaderPercent.textContent = `LOADING ${progress}%`;
          }
        }, 90);
      }

      // 验证
      function verifyPassword() {
        const entered = passwordInput.value.trim();
        if (entered === VALID_PASS) {
          authError.textContent = '';
          authLayer.style.display = 'none';
          pageLoader.classList.add('active');
          mainInterface.style.display = 'none';
          startLoader(() => {
            mainInterface.style.display = 'flex';
            startIpAnimation();
            setTimeout(() => {
              initRadarCharts();
            }, 100);
          });
        } else {
          authError.textContent = 'ACCESS DENIED · INVALID PASSCODE';
          passwordInput.value = '';
          passwordInput.style.borderColor = '#b22222';
          setTimeout(() => {
            passwordInput.style.borderColor = '#3a3a3a';
          }, 300);
        }
      }

      authBtn.addEventListener('click', verifyPassword);
      passwordInput.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') verifyPassword();
      });

      window.addEventListener('load', () => {
        passwordInput.focus();
        initTabs();
      });

      mainInterface.style.display = 'none';
    })();
  </script>
