<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>太阳神车队 · 钻透月亮</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Courier New', 'Consolas', 'SF Mono', monospace;
    }

    body {
      background-color: #050505;
      color: #e0e0e0;
      font-size: 12px;
      line-height: 1.4;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      letter-spacing: 0.3px;
    }

    .system {
      width: 100%;
      max-width: 1440px;
      background: #0a0a0a;
      border: 1px solid #2a2a2a;
      box-shadow: 0 0 20px rgba(180, 20, 20, 0.2);
      padding: 20px 24px 24px;
      position: relative;
      min-height: 650px;
    }

    .system::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, #8b0000, #b22222, #8b0000);
    }

    h1, h2, h3, h4, p, span, div, label, input, button {
      font-size: 11px;
      font-weight: 400;
    }

    /* ===== 加载动画 ===== */
    .page-loader {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #050505;
      z-index: 9999;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }

    .page-loader.active {
      display: flex;
    }

    .page-loader.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .loader-logo {
      color: #b22222;
      letter-spacing: 8px;
      font-size: 16px;
      margin-bottom: 30px;
      text-transform: uppercase;
      border-bottom: 1px solid #3a1a1a;
      padding-bottom: 10px;
      animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }

    .loader-bar-wrap {
      width: 260px;
      height: 4px;
      background: #1a1a1a;
      border: 1px solid #2a2a2a;
      overflow: hidden;
      position: relative;
    }

    .loader-bar {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #8b0000, #b22222);
      animation: loadBar 2.2s ease-in-out forwards;
    }

    @keyframes loadBar {
      0% { width: 0%; }
      20% { width: 15%; }
      50% { width: 48%; }
      80% { width: 82%; }
      100% { width: 100%; }
    }

    .loader-percent {
      margin-top: 12px;
      color: #888;
      font-size: 11px;
      letter-spacing: 3px;
    }

    /* 密码输入层 */
    .auth-layer {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 500px;
      background: #070707;
      border: 1px solid #2f2f2f;
      padding: 40px 20px;
    }

    .auth-title {
      color: #b22222;
      letter-spacing: 4px;
      text-transform: uppercase;
      border-bottom: 1px solid #3a1a1a;
      padding-bottom: 8px;
      margin-bottom: 30px;
      font-size: 14px;
    }

    .auth-input-group {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      width: 280px;
    }

    .auth-input-group input {
      width: 100%;
      background: #111;
      border: 1px solid #3a3a3a;
      color: #f0f0f0;
      padding: 10px 14px;
      font-size: 12px;
      letter-spacing: 6px;
      text-align: center;
      outline: none;
      transition: 0.2s;
    }

    .auth-input-group input:focus {
      border-color: #b22222;
      box-shadow: 0 0 8px rgba(178, 34, 34, 0.4);
    }

    .auth-btn {
      background: #111;
      border: 1px solid #8b0000;
      color: #e0e0e0;
      padding: 10px 30px;
      text-transform: uppercase;
      letter-spacing: 4px;
      cursor: pointer;
      transition: 0.2s;
      font-weight: 600;
    }

    .auth-btn:hover {
      background: #1a0a0a;
      border-color: #b22222;
      color: #fff;
    }

    .auth-error {
      color: #b22222;
      margin-top: 8px;
      height: 16px;
      font-size: 11px;
    }

    /* 主界面 */
    .main-interface {
      display: none;
      flex-direction: column;
      width: 100%;
      gap: 16px;
    }

    /* 状态栏 */
    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #0d0d0d;
      border: 1px solid #2c2c2c;
      padding: 10px 14px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .ip-loader {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .loader-ring {
      width: 18px;
      height: 18px;
      border: 2px solid #2a2a2a;
      border-top: 2px solid #b22222;
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    .ip-text {
      color: #888;
      letter-spacing: 1px;
    }

    .ip-text .red {
      color: #b22222;
      font-weight: 600;
    }

    .account-info {
      display: flex;
      gap: 20px;
      color: #aaa;
    }

    .account-info span {
      color: #b22222;
    }

    /* 标签页导航 */
    .tabs {
      display: flex;
      border-bottom: 1px solid #2a2a2a;
      gap: 2px;
      flex-wrap: wrap;
    }

    .tab-btn {
      background: transparent;
      border: 1px solid transparent;
      border-bottom: none;
      color: #7a7a7a;
      padding: 8px 20px;
      cursor: pointer;
      text-transform: uppercase;
      letter-spacing: 2px;
      font-size: 10px;
      transition: 0.2s;
      position: relative;
      top: 1px;
    }

    .tab-btn:hover {
      color: #ccc;
      background: #111;
    }

    .tab-btn.active {
      color: #e0e0e0;
      background: #0f0f0f;
      border-color: #2a2a2a #2a2a2a #0f0f0f #2a2a2a;
      border-top: 2px solid #b22222;
      font-weight: 600;
    }

    /* 内容面板 */
    .panel {
      background: #0b0b0b;
      border: 1px solid #242424;
      padding: 20px 18px;
      min-height: 420px;
    }

    .panel-content {
      display: none;
      flex-direction: column;
      gap: 20px;
    }

    .panel-content.active {
      display: flex;
    }

    /* ===== 雷达图 ===== */
    .radar-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
    }

    .radar-card {
      flex: 1 1 300px;
      background: #0e0e0e;
      border: 1px solid #2e2e2e;
      padding: 16px;
      opacity: 0;
      transform: translateY(10px);
      animation: fadeUp 0.6s ease forwards;
    }

    .radar-card:nth-child(1) { animation-delay: 0.1s; }
    .radar-card:nth-child(2) { animation-delay: 0.25s; }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    .radar-title {
      color: #b22222;
      text-transform: uppercase;
      letter-spacing: 3px;
      border-left: 3px solid #b22222;
      padding-left: 8px;
      margin-bottom: 16px;
      font-size: 12px;
    }

    .radar-chart-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 16px;
      position: relative;
    }

    .radar-svg {
      width: 100%;
      max-width: 260px;
      height: auto;
      overflow: visible;
    }

    .radar-poly {
      fill: rgba(178, 34, 34, 0.15);
      stroke: #b22222;
      stroke-width: 1.8;
      stroke-linejoin: round;
      transition: 0.3s;
      animation: radarExpand 0.9s ease-out forwards;
      transform-origin: center;
      transform: scale(0);
    }

    @keyframes radarExpand {
      0% { transform: scale(0); opacity: 0; }
      70% { transform: scale(1.05); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }

    .radar-grid-line {
      stroke: #2a2a2a;
      stroke-width: 0.8;
      fill: none;
    }

    .radar-axis {
      stroke: #333;
      stroke-width: 0.8;
    }

    .radar-label {
      fill: #888;
      font-size: 8px;
      text-anchor: middle;
      dominant-baseline: middle;
      letter-spacing: 0.5px;
    }

    .stat-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 6px;
      border-bottom: 1px solid #1e1e1e;
      padding-bottom: 3px;
    }

    .stat-label {
      color: #9a9a9a;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .stat-value {
      color: #ddd;
      font-weight: 600;
    }

    .stat-value.highlight {
      color: #b22222;
    }

    .analysis-block {
      margin-top: 16px;
      border-top: 1px solid #232323;
      padding-top: 12px;
      color: #aaa;
      font-size: 11px;
      line-height: 1.6;
    }

    .analysis-block strong {
      color: #b22222;
      font-weight: 600;
    }

    .rating {
      display: inline-block;
      border: 1px solid #b22222;
      color: #b22222;
      padding: 2px 8px;
      margin-left: 8px;
      font-size: 10px;
      letter-spacing: 1px;
    }

    /* 生理心理指标 */
    .bio-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 14px;
      border-top: 1px solid #1e1e1e;
      padding-top: 12px;
    }

    .bio-item {
      background: #0a0a0a;
      border: 1px solid #1e1e1e;
      padding: 10px;
    }

    .bio-label {
      color: #888;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-size: 10px;
      margin-bottom: 4px;
    }

    .bio-value {
      color: #ddd;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1px;
    }

    .bio-value .unit {
      color: #666;
      font-size: 9px;
      margin-left: 4px;
    }

    .bio-value.warning {
      color: #b22222;
    }

    .bio-desc {
      color: #666;
      font-size: 9px;
      margin-top: 4px;
      letter-spacing: 0.5px;
    }

    /* ===== 赛道模拟训练 ===== */
    .track-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 16px;
    }

    .track-card {
      background: #0e0e0e;
      border: 1px solid #262626;
      padding: 14px;
    }

    .track-name {
      color: #b22222;
      text-transform: uppercase;
      letter-spacing: 2px;
      border-bottom: 1px solid #2a1a1a;
      padding-bottom: 6px;
      margin-bottom: 10px;
    }

    .track-map {
      width: 100%;
      height: 110px;
      background: #0a0a0a;
      border: 1px solid #1e1e1e;
      margin-bottom: 10px;
      position: relative;
      overflow: hidden;
    }

    .track-map svg {
      width: 100%;
      height: 100%;
    }

    .track-detail {
      color: #aaa;
      font-size: 11px;
      margin-bottom: 4px;
    }

    .track-result {
      color: #ddd;
      margin-top: 8px;
      border-left: 2px solid #b22222;
      padding-left: 8px;
    }

    .track-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
      font-size: 10px;
      color: #777;
    }

    .track-stats span {
      background: #131313;
      padding: 2px 8px;
      border: 1px solid #222;
    }

    /* 温湿度分析 */
    .weather-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
      margin-top: 10px;
      border-top: 1px solid #1e1e1e;
      padding-top: 10px;
    }

    .weather-item {
      background: #0a0a0a;
      border: 1px solid #1a1a1a;
      padding: 8px;
      text-align: center;
    }

    .weather-label {
      color: #666;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 4px;
    }

    .weather-value {
      color: #ddd;
      font-size: 12px;
      font-weight: 600;
    }

    .weather-value.red {
      color: #b22222;
    }

    /* ===== 车身情况 ===== */
    .car-spec {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 16px;
    }

    .car-item {
      background: #0e0e0e;
      border: 1px solid #2a2a2a;
      padding: 14px;
    }

    .car-item .label {
      color: #b22222;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin-bottom: 8px;
      border-bottom: 1px solid #1e1e1e;
      padding-bottom: 4px;
      font-size: 11px;
    }

    .car-item .value {
      color: #ccc;
      margin-bottom: 4px;
      display: flex;
      justify-content: space-between;
    }

    .car-item .value .spec-key {
      color: #888;
    }

    .car-item .value .spec-val {
      color: #ddd;
      font-weight: 500;
    }

    .car-item .value .spec-val.red {
      color: #b22222;
    }

    /* 零件寿命环 */
    .life-ring-wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 10px;
      border-top: 1px solid #1e1e1e;
      padding-top: 12px;
    }

    .life-ring {
      flex: 1 1 80px;
      text-align: center;
    }

    .life-ring svg {
      width: 60px;
      height: 60px;
    }

    .life-ring .ring-label {
      color: #888;
      font-size: 9px;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-top: 4px;
    }

    .ring-bg {
      fill: none;
      stroke: #1a1a1a;
      stroke-width: 4;
    }

    .ring-fill {
      fill: none;
      stroke: #b22222;
      stroke-width: 4;
      stroke-linecap: round;
      transition: stroke-dasharray 0.6s ease;
    }

    .ring-text {
      fill: #ddd;
      font-size: 10px;
      text-anchor: middle;
      dominant-baseline: middle;
      font-weight: 600;
    }

    /* 温度条 */
    .temp-bar-wrap {
      margin-top: 10px;
      border-top: 1px solid #1e1e1e;
      padding-top: 10px;
    }

    .temp-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }

    .temp-label {
      color: #888;
      font-size: 10px;
      min-width: 80px;
      text-transform: uppercase;
    }

    .temp-bar {
      flex: 1;
      height: 6px;
      background: #1a1a1a;
      border: 1px solid #222;
      position: relative;
      overflow: hidden;
    }

    .temp-fill {
      height: 100%;
      background: linear-gradient(90deg, #4a1a1a, #b22222);
      transition: width 0.4s;
    }

    .temp-fill.warning {
      background: linear-gradient(90deg, #b22222, #ff3333);
    }

    .temp-val {
      color: #ddd;
      font-size: 10px;
      min-width: 50px;
      text-align: right;
    }

    /* 通讯 */
    .comm-log {
      background: #0a0a0a;
      border: 1px solid #222;
      padding: 12px;
      font-size: 11px;
      color: #b0b0b0;
      max-height: 400px;
      overflow-y: auto;
    }

    .comm-line {
      border-bottom: 1px solid #1a1a1a;
      padding: 6px 0;
      display: flex;
      gap: 12px;
    }

    .comm-time {
      color: #b22222;
      min-width: 70px;
    }

    .comm-sender {
      color: #ddd;
      min-width: 80px;
    }

    .comm-section {
      color: #b22222;
      text-transform: uppercase;
      letter-spacing: 2px;
      margin: 14px 0 8px;
      border-bottom: 1px solid #2a1a1a;
      padding-bottom: 4px;
      font-size: 10px;
    }

    /* ===== 人员编制 ===== */
    .roster-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
      border-bottom: 1px solid #2a1a1a;
      padding-bottom: 10px;
      flex-wrap: wrap;
    }

    .roster-header .holding-label {
      color: #b22222;
      letter-spacing: 3px;
      text-transform: uppercase;
      border: 1px solid #b22222;
      padding: 4px 14px;
      font-size: 12px;
      font-weight: 600;
    }

    .roster-header .holding-desc {
      color: #888;
      font-size: 10px;
      letter-spacing: 1px;
    }

    .roster-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
    }

    .person-card {
      background: #0e0e0e;
      border-left: 3px solid #b22222;
      padding: 12px;
      border-top: 1px solid #1e1e1e;
      border-right: 1px solid #1e1e1e;
      border-bottom: 1px solid #1e1e1e;
    }

    .person-name {
      color: #fff;
      font-weight: 600;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .person-role {
      color: #b22222;
      margin: 4px 0 6px;
      font-size: 10px;
      letter-spacing: 1px;
    }

    .person-detail {
      color: #888;
      font-size: 10px;
    }

    .footer-note {
      margin-top: 16px;
      border-top: 1px solid #1e1e1e;
      padding-top: 12px;
      color: #6a6a6a;
      letter-spacing: 1px;
      text-align: right;
    }

    .footer-note span {
      color: #b22222;
    }

    ::-webkit-scrollbar {
      width: 6px;
      background: #0a0a0a;
    }
    ::-webkit-scrollbar-thumb {
      background: #3a1a1a;
    }
  </style>
</head>
<body>

  <!-- 加载动画 -->
  <div id="pageLoader" class="page-loader">
    <div class="loader-logo">SUN CHARIOT · SYSTEM</div>
    <div class="loader-bar-wrap">
      <div class="loader-bar"></div>
    </div>
    <div class="loader-percent" id="loaderPercent">LOADING 0%</div>
  </div>

  <div class="system">
    <!-- 密码验证层 -->
    <div id="authLayer" class="auth-layer">
      <div class="auth-title">SUN CHARIOT · ACCESS</div>
      <div class="auth-input-group">
        <input type="password" id="passwordInput" placeholder="ENTER PASSCODE" maxlength="10" autocomplete="off">
        <button class="auth-btn" id="authBtn">验证</button>
        <div class="auth-error" id="authError"></div>
      </div>
    </div>

    <!-- 主界面 -->
    <div id="mainInterface" class="main-interface">
      <!-- 状态栏 -->
      <div class="status-bar">
        <div class="ip-loader">
          <div class="loader-ring"></div>
          <div class="ip-text">VERIFYING IP · <span class="red" id="ipAddress">10.27.62.1</span> · SECURE</div>
        </div>
        <div class="account-info">
          <div>ACCOUNT: <span>Z0627M</span></div>
          <div>LEVEL: <span>MAXIMUM</span></div>
        </div>
      </div>

      <!-- 标签页 -->
      <div class="tabs">
        <button class="tab-btn active" data-tab="tab1">选手分析</button>
        <button class="tab-btn" data-tab="tab2">赛道模拟训练</button>
        <button class="tab-btn" data-tab="tab3">车身情况</button>
        <button class="tab-btn" data-tab="tab4">战术通信</button>
        <button class="tab-btn" data-tab="tab5">人员编制</button>
      </div>

      <!-- 面板内容 -->
      <div class="panel">
        <!-- 标签1：选手分析（含生理心理） -->
        <div id="tab1" class="panel-content active">
          <div class="radar-grid">
            <!-- 宗岩雷 -->
            <div class="radar-card">
              <div class="radar-title">ZONG YANLEI · DRIVER</div>
              <div class="radar-chart-wrap">
                <svg class="radar-svg" viewBox="0 0 220 220" preserveAspectRatio="xMidYMid meet">
                  <g id="radarGridZong"></g>
                  <g id="radarAxesZong"></g>
                  <polygon class="radar-poly" id="radarPolyZong" points="" />
                  <g id="radarLabelsZong"></g>
                </svg>
              </div>
              <div class="stat-row"><span class="stat-label">力量 POWER</span><span class="stat-value">97</span></div>
              <div class="stat-row"><span class="stat-label">速度 SPEED</span><span class="stat-value highlight">99</span></div>
              <div class="stat-row"><span class="stat-label">爆发力 EXPLOSIVENESS</span><span class="stat-value">94</span></div>
              <div class="stat-row"><span class="stat-label">技巧 TECHNIQUE</span><span class="stat-value highlight">100</span></div>
              <div class="stat-row"><span class="stat-label">语言表达 VERBAL</span><span class="stat-value">23</span></div>
              <div class="stat-row"><span class="stat-label">直觉 INTUITION</span><span class="stat-value">93</span></div>
              <div class="stat-row"><span class="stat-label">执行 EXECUTION</span><span class="stat-value">76</span></div>

              <!-- 生理心理指标 -->
              <div class="bio-grid">
                <div class="bio-item">
